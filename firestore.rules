rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default deny all unspecified collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation helper for Message entities
    function isValidMessage(data) {
      return data.id is string && isValidId(data.id)
        && data.roomId is string && isValidId(data.roomId)
        && data.sender is map
        && data.sender.uid is string
        && data.sender.uid == request.auth.uid
        && data.timestamp is number
        && (!('content' in data) || (data.content is string && data.content.size() <= 2000))
        && (!('image' in data) || data.image == null || (data.image is string && data.image.size() <= 4000000));
    }

    // Validation helper for User Profile entities
    function isValidUser(data, userId) {
      return data.uid is string && data.uid == request.auth.uid && data.uid == userId
        && data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && data.email is string && data.email.size() > 0 && data.email.size() <= 120
        && (!('status' in data) || (data.status in ['online', 'away', 'studying']));
    }

    // Collection: Users (/users/{userId})
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(userId) && isValidUser(incoming(), userId);
      allow update: if isSignedIn() && isValidId(userId) && isValidUser(incoming(), userId)
        && incoming().uid == existing().uid;
      allow delete: if false;
    }

    // Collection: Channels (/channels/{channelId})
    match /channels/{channelId} {
      allow read: if isSignedIn();
      allow write: if false; // Predefined server channels
    }

    // Collection: Messages (/messages/{messageId})
    match /messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(messageId) && isValidMessage(incoming());
      // Updates allowed for emoji reaction toggles and read receipts
      allow update: if isSignedIn() && isValidId(messageId)
        && incoming().id == existing().id
        && incoming().roomId == existing().roomId
        && incoming().sender.uid == existing().sender.uid
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['reactions']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['seenBy']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['reactions', 'seenBy'])
        );
      allow delete: if isSignedIn() && isValidId(messageId) && existing().sender.uid == request.auth.uid;
    }

  }
}
